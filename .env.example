# Copy to .env and fill in real values. Never commit .env.
# Flask / authentication
# Generate a long random value for the real .env. Never commit it.
SECRET_KEY=replace-with-a-long-random-secret

# false for localhost HTTP; true when deployed using HTTPS
SESSION_COOKIE_SECURE=false

# Authenticated session lifetime
SESSION_LIFETIME_MINUTES=30

# Keep false unless actively debugging locally
FLASK_DEBUG=false
# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scms_db
DB_USER=scms_user
DB_PASSWORD=change-me

# Separate database used only by tests/db (must differ from DB_NAME)
TEST_DB_NAME=scms_test_db

# Demo accounts created by db/seed_demo_users.py
DEMO_RESIDENT_EMAIL=resident@example.com
DEMO_RESIDENT_PASSWORD=change-me
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=change-me
