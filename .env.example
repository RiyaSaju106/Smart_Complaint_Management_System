# Copy to .env and fill in real values. Never commit .env.

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scms_db
DB_USER=scms_user
DB_PASSWORD=change-me

# Separate database used only by tests/db (must differ from DB_NAME)
TEST_DB_NAME=scms_test_db

# Demo accounts created by db/seed_demo_users.py
DEMO_RESIDENT_EMAIL=resident@example.com
DEMO_RESIDENT_PASSWORD=change-me
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=change-me
